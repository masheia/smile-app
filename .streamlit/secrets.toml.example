# Copy this file to .streamlit/secrets.toml for a local run.
# On Streamlit Community Cloud, paste the same values into the app's Secrets box.
# Never commit secrets.toml.

[snowflake]
account = "ORGNAME-ACCOUNTNAME"
user = "SMILE_APP_USER"
password = "the password you set in setup.sql"
role = "SMILE_APP_ROLE"
warehouse = "SMILE_APP_WH"
database = "SMILE_APP_DB"
schema = "PUBLIC"
